# ---------------------------------------------------------------------------
# Supabase — obligatorio
# Panel de Supabase > Project Settings > API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Marca blanca (opcional) — permite revender la app a varias autoescuelas
# ---------------------------------------------------------------------------
VITE_APP_NAME="Autoescuela Demo"
VITE_APP_LOGO_URL=

# ---------------------------------------------------------------------------
# IA — TODO ESTO ES OPCIONAL.
# Sin ninguna clave la app funciona igual: usa el motor determinista local
# (explicaciones del banco de preguntas + analítica de fallos), coste 0.
#
# Las claves NUNCA se ponen aquí en producción: se guardan como secretos de la
# Edge Function para que no lleguen al navegador.
#   supabase secrets set AI_PROVIDER=groq AI_API_KEY=gsk_...
#
# Proveedores soportados por la Edge Function `ai-tutor`:
#   groq      -> free tier generoso, sin tarjeta          (recomendado, 0 €)
#   gemini    -> free tier de Google AI Studio            (0 €)
#   openai    -> de pago
#   anthropic -> de pago
#   ollama    -> modelo local, requiere servidor propio
# ---------------------------------------------------------------------------
# AI_PROVIDER=groq
# AI_API_KEY=
# AI_MODEL=
